# 配对的 GLM-5.2 FP8 审查版本对比配置。
# 调用支持 GLM 的 launcher 或 subset runner 前先 source 本文件。

GLM52_OFFICIAL_REPOSITORY="zai-org/GLM-5.2-FP8"
GLM52_OFFICIAL_REVISION="ba978f7d347eaf65d22f1a86833408afdb953541"
GLM52_OFFICIAL_SERVED_NAME="glm52-fp8-official"

GLM52_UNCENSORED_REPOSITORY="zandenAI/GLM-5.2-FP8-Uncensored"
GLM52_UNCENSORED_REVISION="fba2a5efe0cb5913c9562fde7a2e00c6b4573e50"
GLM52_UNCENSORED_SERVED_NAME="glm52-fp8-uncensored"

# 保留的旧 Qwen 入口，不属于默认 GLM 对比。
# QWEN_OFFICIAL_REPOSITORY="Qwen/Qwen3.6-35B-A3B"
# QWEN_UNCENSORED_REPOSITORY="llmfan46/Qwen3.6-35B-A3B-uncensored-heretic"

# Agent 上下文策略。guided 会记录指标并给出收敛提示，但不会阻止工具；
# baseline 用于旧行为对照，enforced 会执行强制门控。
AGENT_POLICY_MODE="${AGENT_POLICY_MODE:-guided}"
# 在限制宽泛浏览前允许的 read_file 最大调用次数。
AGENT_READ_CALL_BUDGET="${AGENT_READ_CALL_BUDGET:-18}"
# 在触发相同策略前，允许主 Agent 看到的源码字符总量。
AGENT_SOURCE_CHAR_BUDGET="${AGENT_SOURCE_CHAR_BUDGET:-120000}"
# 未更新结构化假设时允许连续执行的浏览类工具次数。
AGENT_STALE_TOOL_LIMIT="${AGENT_STALE_TOOL_LIMIT:-6}"
# 提醒首次提交候选的工具调用截止次数。
AGENT_FIRST_SUBMIT_TOOL_DEADLINE="${AGENT_FIRST_SUBMIT_TOOL_DEADLINE:-12}"
# 超长结果总结 Agent。本 profile 由本地 launcher source 时跟随其 served_model_name；
# 否则默认使用官方 FP8 模型。可导出同 endpoint 的其他模型 ID 覆盖，或导出空字符串关闭。
AGENT_TOOL_SUMMARY_MODEL="${AGENT_TOOL_SUMMARY_MODEL-${served_model_name:-${GLM52_OFFICIAL_SERVED_NAME}}}"
