# 官方 Anthropic Claude Code Agent SDK 配置。不要在此保存密钥。
# 运行前执行：export ANTHROPIC_API_KEY='...'

USE_CLAUDE_CODE_AGENT="${USE_CLAUDE_CODE_AGENT:-true}"
CLAUDE_CODE_PROVIDER="${CLAUDE_CODE_PROVIDER:-anthropic}"
CLAUDE_CODE_MODEL="${CLAUDE_CODE_MODEL:-claude-sonnet-4-6}"
CLAUDE_CODE_API_KEY_ENV="${CLAUDE_CODE_API_KEY_ENV:-ANTHROPIC_API_KEY}"

# 总任务轮次按此大小拆分为新的 SDK session；后续 session 只接收
# working-memory.md，不携带旧的原始对话记录。
API_MAX_STEPS="${API_MAX_STEPS:-48}"
CLAUDE_CODE_SESSION_TURN_BUDGET="${CLAUDE_CODE_SESSION_TURN_BUDGET:-12}"
API_REQUEST_TIMEOUT_S="${API_REQUEST_TIMEOUT_S:-1800}"
API_MAX_TOOL_RESULT_CHARS="${API_MAX_TOOL_RESULT_CHARS:-12288}"

# Agent 上下文策略。guided 会记录指标并给出收敛提示，但不会阻止工具；
# baseline 用于旧行为对照，enforced 会执行强制门控。
AGENT_POLICY_MODE="${AGENT_POLICY_MODE:-guided}"
# 在限制宽泛浏览前允许的 read_file 最大调用次数。
AGENT_READ_CALL_BUDGET="${AGENT_READ_CALL_BUDGET:-18}"
# 在触发相同策略前，允许主 Agent 看到的源码字符总量。
AGENT_SOURCE_CHAR_BUDGET="${AGENT_SOURCE_CHAR_BUDGET:-120000}"
# 未更新结构化假设时允许连续执行的浏览类工具次数。
AGENT_STALE_TOOL_LIMIT="${AGENT_STALE_TOOL_LIMIT:-6}"
# 提醒首次提交候选的工具调用截止次数。
AGENT_FIRST_SUBMIT_TOOL_DEADLINE="${AGENT_FIRST_SUBMIT_TOOL_DEADLINE:-12}"
# 超长结果总结 Agent；默认复用当前 Claude 模型、endpoint 和认证 key。
# 若同一 Anthropic-compatible endpoint 还提供其他模型，可在 source 前导出其模型 ID；
# 导出 AGENT_TOOL_SUMMARY_MODEL='' 可关闭模型总结。
AGENT_TOOL_SUMMARY_MODEL="${AGENT_TOOL_SUMMARY_MODEL-${CLAUDE_CODE_MODEL}}"
