# High-fidelity reproduction of the public DeepSeek-V4-Flash-0731 agent settings.
# The official DeepSeek Harness is not yet public, and the router exposes only
# the alias below without a checkpoint revision, so this profile must not be
# described as an official-harness run.
API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="infi/deepseek-v4-flash"
API_KEY_ENV="CYBERGYM_DEEPSEEK_API_KEY"
API_MODE="chat_completions"

# Public model-card settings for code-agent evaluations.
API_TEMPERATURE="1.0"

# V4 declares a 1,048,576-token context and recommends up to 384K output for
# high/max reasoning. Reserve roughly 600K estimated input tokens and bound
# each tool result so one accidental dump cannot evict the useful history.
API_MAX_TOKENS="393216"

# run_api_subset.sh intentionally remains unchanged. These exported evaluator
# defaults are consumed directly by run_langgraph_eval.py.
export CYBERGYM_REASONING_EFFORT="max"
export CYBERGYM_TOP_P="0.95"
export CYBERGYM_CONTEXT_TOKEN_BUDGET="600000"
export CYBERGYM_MAX_TOOL_RESULT_CHARS="32768"

API_MAX_STEPS="200"
API_REQUEST_TIMEOUT_S="9000"
API_REQUEST_RETRIES="2"
