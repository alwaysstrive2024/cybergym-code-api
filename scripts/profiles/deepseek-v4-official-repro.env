# 高保真复现公开的 DeepSeek-V4-Flash-0731 Agent 配置。
# DeepSeek 官方 Harness 尚未公开，router 也只提供下面的别名而没有 checkpoint
# revision，因此不得将本 profile 描述为官方 Harness 运行。
API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="infi/deepseek-v4-flash"
API_KEY_ENV="CYBERGYM_DEEPSEEK_API_KEY"
API_MODE="chat_completions"

# 公开模型卡中的代码 Agent 评测设置。
API_TEMPERATURE="1.0"

# V4 声明 1,048,576 token 上下文，并建议 high/max reasoning 最多使用 384K 输出。
# 这里为估算输入预留约 600K token，并限制单次工具结果，避免意外大输出挤掉有效历史。
API_MAX_TOKENS="393216"

# run_api_subset.sh 保持兼容；以下导出的评测默认值由 run_langgraph_eval.py 直接读取。
export CYBERGYM_REASONING_EFFORT="max"
export CYBERGYM_TOP_P="0.95"
export CYBERGYM_CONTEXT_TOKEN_BUDGET="600000"
export CYBERGYM_MAX_TOOL_RESULT_CHARS="32768"

API_MAX_STEPS="200"
API_REQUEST_TIMEOUT_S="9000"
API_REQUEST_RETRIES="2"

# Agent 上下文策略。guided 会记录指标并给出收敛提示，但不会阻止工具；
# baseline 用于旧行为对照，enforced 会执行强制门控。
AGENT_POLICY_MODE="${AGENT_POLICY_MODE:-guided}"
# 在限制宽泛浏览前允许的 read_file 最大调用次数。
AGENT_READ_CALL_BUDGET="${AGENT_READ_CALL_BUDGET:-18}"
# 在触发相同策略前，允许主 Agent 看到的源码字符总量。
AGENT_SOURCE_CHAR_BUDGET="${AGENT_SOURCE_CHAR_BUDGET:-120000}"
# 未更新结构化假设时允许连续执行的浏览类工具次数。
AGENT_STALE_TOOL_LIMIT="${AGENT_STALE_TOOL_LIMIT:-6}"
# 提醒首次提交候选的工具调用截止次数。
AGENT_FIRST_SUBMIT_TOOL_DEADLINE="${AGENT_FIRST_SUBMIT_TOOL_DEADLINE:-12}"
# 超长结果总结 Agent；默认复用同一 endpoint 上的 API_MODEL 和当前 API key。
# 可在 source 前导出其他同 provider 模型 ID；导出空字符串可关闭模型总结。
AGENT_TOOL_SUMMARY_MODEL="${AGENT_TOOL_SUMMARY_MODEL-${API_MODEL}}"
