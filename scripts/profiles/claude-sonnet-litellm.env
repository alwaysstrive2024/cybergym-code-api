API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="claude-sonnet-4-6"
API_KEY_ENV="CYBERGYM_SONNET_API_KEY"
API_MODE="chat_completions"
API_REQUEST_TIMEOUT_S="7200"
API_MAX_STEPS="200"
API_MAX_TOKENS="40960" # Claude Code 路线不会读取此参数，因此不生效。
API_TEMPERATURE="1.0"
API_REQUEST_RETRIES="2"
CLAUDE_CODE_SESSION_TURN_BUDGET="24"
USE_CLAUDE_CODE_AGENT="true"
API_MAX_TOOL_RESULT_CHARS="8192"

CLAUDE_CODE_PROVIDER="anthropic_compatible"
CLAUDE_CODE_MODEL="${API_MODEL}"
CLAUDE_CODE_BASE_URL="${API_BASE_URL}"
CLAUDE_CODE_API_KEY_ENV="${API_KEY_ENV}"

# Agent 上下文策略。guided 会记录指标并给出收敛提示，但不会阻止工具；
# baseline 用于旧行为对照，enforced 会执行强制门控。
AGENT_POLICY_MODE="${AGENT_POLICY_MODE:-guided}"
# 在限制宽泛浏览前允许的 read_file 最大调用次数。
AGENT_READ_CALL_BUDGET="${AGENT_READ_CALL_BUDGET:-18}"
# 在触发相同策略前，允许主 Agent 看到的源码字符总量。
AGENT_SOURCE_CHAR_BUDGET="${AGENT_SOURCE_CHAR_BUDGET:-120000}"
# 未更新结构化假设时允许连续执行的浏览类工具次数。
AGENT_STALE_TOOL_LIMIT="${AGENT_STALE_TOOL_LIMIT:-6}"
# 提醒首次提交候选的工具调用截止次数。
AGENT_FIRST_SUBMIT_TOOL_DEADLINE="${AGENT_FIRST_SUBMIT_TOOL_DEADLINE:-12}"
# 超长结果总结 Agent；默认复用同一 endpoint 上的 API_MODEL 和当前 API key。
# 可在 source 前导出其他同 endpoint 模型 ID；导出空字符串可关闭模型总结。
AGENT_TOOL_SUMMARY_MODEL="${AGENT_TOOL_SUMMARY_MODEL-${API_MODEL}}"
