API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="infi/glm-5.2"
API_KEY_ENV="CYBERGYM_GLM_API_KEY"
API_MODE="chat_completions"
API_REQUEST_TIMEOUT_S="7200"
API_MAX_STEPS="200"
API_MAX_TOKENS="40960" # Claude Code 路线不会读取此参数，因此不生效。
API_TEMPERATURE="1.0"
API_REQUEST_RETRIES="2"
CLAUDE_CODE_SESSION_TURN_BUDGET="24"
USE_CLAUDE_CODE_AGENT="true"
CLAUDE_CODE_PROVIDER="bridge"
# 为同一 Claude Code session 生成稳定的 OpenAI prompt_cache_key，帮助 router 将连续请求路由到同一缓存分区。
API_PROMPT_CACHE_KEY_MODE="${API_PROMPT_CACHE_KEY_MODE:-stable}"
# 单个工具结果展示上限。默认高于 read_file 的 16000 字符硬上限，
# 避免普通源码读取被总结或截成不连续的首尾片段；终端可按需覆盖。
API_MAX_TOOL_RESULT_CHARS="${API_MAX_TOOL_RESULT_CHARS:-20000}"

# GLM endpoint 的并发能力已独立验证，因此使用不同于共享 API 的默认值。
: "${EVAL_CONCURRENCY:=2}"
: "${API_GATEWAY_502_LIMIT:=20}"
: "${EVAL_MEMORY_BUDGET_GIB:=150}"
: "${EVAL_MEMORY_RESERVE_PER_TASK_GIB:=8}"

# Agent 上下文策略。guided 会记录指标并给出收敛提示，但不会阻止工具；
# baseline 用于旧行为对照，enforced 会执行强制门控。
AGENT_POLICY_MODE="${AGENT_POLICY_MODE:-guided}"
# 在限制宽泛浏览前允许的 read_file 最大调用次数。
AGENT_READ_CALL_BUDGET="${AGENT_READ_CALL_BUDGET:-40}"
# 在触发相同策略前，允许主 Agent 看到的源码字符总量。
AGENT_SOURCE_CHAR_BUDGET="${AGENT_SOURCE_CHAR_BUDGET:-300000}"
# 未更新结构化假设时允许连续执行的浏览类工具次数。
AGENT_STALE_TOOL_LIMIT="${AGENT_STALE_TOOL_LIMIT:-30}"
# 提醒首次提交候选的工具调用截止次数。
AGENT_FIRST_SUBMIT_TOOL_DEADLINE="${AGENT_FIRST_SUBMIT_TOOL_DEADLINE:-50}"
# 超长结果总结 Agent；默认复用当前 GLM 模型、router endpoint 和 API key。
# 可在 source 前导出该 router 提供的其他模型 ID；导出空字符串可关闭模型总结。
AGENT_TOOL_SUMMARY_MODEL="${AGENT_TOOL_SUMMARY_MODEL-${API_MODEL}}"
