API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="infi/glm-5.2"
API_KEY_ENV="CYBERGYM_GLM_API_KEY"
API_MODE="chat_completions"
API_REQUEST_TIMEOUT_S="7200"
API_MAX_STEPS="200"
API_MAX_TOKENS="40960" #claude will not read this, no affect
API_TEMPERATURE="1.0"
API_REQUEST_RETRIES="2"
CLAUDE_CODE_SESSION_TURN_BUDGET="24"
USE_CLAUDE_CODE_AGENT="true"
CLAUDE_CODE_PROVIDER="bridge"
API_MAX_TOOL_RESULT_CHARS="8192"

# GLM endpoint concurrency validated independently from the shared API default.
: "${EVAL_CONCURRENCY:=17}"
: "${API_GATEWAY_502_LIMIT:=20}"
: "${EVAL_MEMORY_BUDGET_GIB:=150}"
: "${EVAL_MEMORY_RESERVE_PER_TASK_GIB:=8}"
