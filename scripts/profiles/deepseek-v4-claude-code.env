# DeepSeek model served through the official Claude Code Agent SDK runtime.
# This is an experimental, non-Anthropic-supported model/runtime combination.
API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="infi/deepseek-v4-flash"
API_KEY_ENV="CYBERGYM_DEEPSEEK_API_KEY"
API_MODE="chat_completions"
API_REQUEST_TIMEOUT_S="9000"
API_MAX_STEPS="200"
API_MAX_TOKENS="40960"
API_TEMPERATURE="1.0"
API_REQUEST_RETRIES="2"

USE_CLAUDE_CODE_AGENT="true"
