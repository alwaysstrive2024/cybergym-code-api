# OpenAI-compatible API profile. This file intentionally contains no secret.
API_BASE_URL="https://router.ai.iiis.co:9443"
API_MODEL="infi/deepseek-v4-flash"
API_KEY_ENV="CYBERGYM_DEEPSEEK_API_KEY"
API_MODE="chat_completions"
API_REQUEST_TIMEOUT_S="9000"
API_MAX_STEPS="200"
API_MAX_TOKENS="40960"
API_TEMPERATURE="0"
API_REQUEST_RETRIES="2"

# Before running, set the key only in the shell:
# export CYBERGYM_DEEPSEEK_API_KEY='replace-with-your-key'
